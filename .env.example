# Token issued by @BotFather. Do not commit a real token.
TELEGRAM_BOT_TOKEN=123456789:ABCDEF_your_token_here

# Numeric Telegram chat IDs. The bot must belong to both chats.
GIFTICON_ACTIVE_CHAT_ID=-1001234567890
GIFTICON_ARCHIVE_CHAT_ID=-1009876543210

# Optional. Defaults to gifticons.db next to bot.py (or /data/gifticons.db in Docker).
# GIFTICON_DB_PATH=/data/gifticons.db
